{
  "name": "lx-music-sync-server",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "prestart": "bun run scripts/download-binary.js && bun run scripts/update-build-hash.js",
    "start": "bun run src/index.ts",
    "predev": "bun run scripts/update-build-hash.js",
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir ./server --target bun --packages=external",
    "build:frontend": "bun run scripts/build-frontend.ts",
    "dev:frontend": "bun run scripts/build-frontend.ts --watch",
    "test": "bun test"
  },
  "engines": {
    "bun": ">= 1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XCQ0607/lxserver.git"
  },
  "author": {
    "name": "XCQ",
    "email": "2406498704@qq.com"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/XCQ0607/lxserver/issues"
  },
  "homepage": "https://github.com/XCQ0607/lxserver#readme",
  "dependencies": {
    "@foobar404/wave": "^2.0.5",
    "archiver": "^8.0.0",
    "brace-expansion": "^5.0.9",
    "file-type": "^22.0.2",
    "formidable": "^3.5.4",
    "log4js": "^6.9.1",
    "lru-cache": "^11.5.2",
    "message2call": "0.1.3",
    "music-tag-native": "^0.2.5",
    "needle": "^3.3.1",
    "socks-proxy-agent": "^10.1.0",
    "tunnel": "^0.0.6",
    "unzipper": "^0.12.5",
    "vm2": "^3.12.1",
    "webdav": "^5.9.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bun": "latest",
    "@types/formidable": "^3.5.1",
    "@types/needle": "^3.3.0",
    "@types/tunnel": "^0.0.7",
    "@types/unzipper": "^0.10.11",
    "@types/ws": "^8.18.1",
    "chalk": "^4.1.2",
    "changelog-parser": "^4.1.0",
    "typescript": "^7.0.2"
  }
}
